generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  title        String
  description  String
  githubUrl    String?
  liveUrl      String?
  technologies String
  createdAt    DateTime @default(now())
}